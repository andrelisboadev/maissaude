# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WhatsApp Gateway (Opcional - Evolution API / Z-API / Meta Cloud)
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""

# WhatsApp oficial (Meta Cloud API) — número de teste gratuito ou número real homologado
META_WHATSAPP_TOKEN="MY_META_TEMPORARY_OR_PERMANENT_TOKEN"
META_PHONE_NUMBER_ID="MY_META_PHONE_NUMBER_ID"
META_VERIFY_TOKEN="escolha-uma-senha-qualquer-para-a-verificacao-do-webhook"

# Mercado Pago (Pix real via API de Pagamentos)
MERCADOPAGO_ACCESS_TOKEN="MY_MERCADOPAGO_ACCESS_TOKEN"

# Provedor de pagamento ativo: "mercadopago" (padrão) ou "inter"
PAYMENT_PROVIDER="mercadopago"

# Banco Inter (Pix via Conta PJ — autenticação por certificado, use apenas se PAYMENT_PROVIDER=inter)
INTER_CLIENT_ID="MY_INTER_CLIENT_ID"
INTER_CLIENT_SECRET="MY_INTER_CLIENT_SECRET"
INTER_PIX_KEY="MY_INTER_PIX_KEY"
# Cole o conteúdo COMPLETO dos arquivos baixados no Internet Banking (Nova Integração),
# incluindo as linhas -----BEGIN CERTIFICATE----- / -----END CERTIFICATE----- etc.
INTER_CERTIFICATE="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
INTER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Chave simples para proteger a rota administrativa de setup (registrar webhook do Inter)
ADMIN_SETUP_KEY="MY_ADMIN_SETUP_KEY"

# Supabase (frontend - Vite injeta variáveis com prefixo VITE_ no bundle do navegador)
VITE_SUPABASE_URL="https://njevudvdahfvezndpryf.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_0BlacMpYcE5UdyH0xRlxqQ_0HvZT42Q"

# Supabase (backend - NUNCA prefixar com VITE_, fica só no servidor)
SUPABASE_URL="https://njevudvdahfvezndpryf.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"
